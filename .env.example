# ORCA Environment Variable Template
# Copy this file to .env and populate keys as appropriate

# Google Gemini API Key for LLM Reasoning Synthesis (Optional - fallback analytical engine used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Copernicus Marine Service (CMEMS) API Credentials (Optional - cached data used if omitted)
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# INCOIS / MOSDAC (ISRO) OOS Data Portal Credentials (Optional)
INCOIS_API_KEY=your_incois_api_key

# Application Settings
ORCA_PORT=8501
FASTAPI_PORT=8000
PYTHONPATH=.
